# BlogFactory web (nginx) for Railway: listen on the injected $PORT instead of a hard-coded 80, so
# Railway's healthcheck and edge proxy reach it without a PORT override that a template cannot publish.
FROM ghcr.io/blogfactoryhq/blogfactory-web:v0.1.0@sha256:73b1b194c4c048b83f8a7ef12186a12cbbc449c9ac7bd59091847ac14340b0da
RUN sed -i 's/listen 80;/listen ${PORT};/' /etc/nginx/templates/default.conf.template \
 && grep -q 'listen ${PORT};' /etc/nginx/templates/default.conf.template
ENV PORT=8080 \
    NGINX_ENVSUBST_FILTER='^(API_UPSTREAM|NGINX_RESOLVER|PORT)$'
EXPOSE 8080
LABEL org.opencontainers.image.source="https://github.com/bon5co/blogfactory-railway" \
      org.opencontainers.image.description="BlogFactory web for Railway: nginx listens on PORT"
